{
  "name": "deepseek-desktop",
  "version": "0.1.0-rc.10",
  "description": "Installer for the DeepSeek desktop app (dsh desktop, arm64). Downloads the release zip and installs DeepSeek.app into ~/Applications.",
  "license": "MIT",
  "os": [
    "darwin"
  ],
  "files": [
    "scripts/install.js",
    "scripts/dsh.js",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node scripts/install.js"
  },
  "bin": {
    "dsh": "scripts/dsh.js"
  },
  "keywords": [
    "deepseek",
    "desktop",
    "dsh",
    "agent",
    "electron"
  ],
  "dependencies": {
    "@deepseek-ai/dsh": "^0.1.0-rc.6"
  }
}
